#
# Application environment variables
#
APP_NAME=fastapi-app
APP_PORT=8000
# SERVER_NAME=portal.boldsystems.org
# SSL_CERT=/path/to/cert
# SSL_CERT_KEY=/path/to/key
#
# Service connection parameters
#
REDIS_HOST=redis
REDIS_PORT=6379
COUCHBASE_ENDPOINT=couchbase://couchbase
COUCHBASE_USER=Administrator
COUCHBASE_PASSWORD=password

# Naturalis options

# GitLab container tag (should match Git branch name)
IMAGE_VERSION=develop
# Server path to directory containing application data
DATA_PATH=./data
# Route53 credentials
AWS_ACCESS_KEY_ID=access_key_id
AWS_SECRET_ACCESS_KEY=secret_access_key
# Server domain name
FQDN=boldsystems.dryrun.link
# Subdomain to access Couchbase web UI
COUCHBASE_FQDN=couchbase.boldsystems.dryrun.link
# GitLab token to access private repo with registry files for import
IMPORT_REGISTRY_TOKEN=gitlab_token
# Path to directory containing import files (from within container!)
IMPORT_DIR=/import
# Basic authentication for dev server
BASIC_AUTH=basic-auth
# Nuke option to delete existing cluster on Docker startup
COUCHBASE_DROP_CLUSTER_ON_START=false
